# --- Backend -------------------------------------------------------------
# AI provider: mock | openai | ollama
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=30

# OpenAI (phase 1+: provider stub only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local models)
OLLAMA_URL=http://localhost:11434
# Initial model; the one picked in the app replaces it and is remembered
OLLAMA_MODEL=gpt-oss:latest
# Reasoning effort for thinking models: low | medium | high | true | false (empty = default).
# Levels only work on gpt-oss; other thinking models (qwen3) treat them as "off".
OLLAMA_THINK=low
# Keep the model in VRAM between messages to avoid cold starts
OLLAMA_KEEP_ALIVE=30m
# Context window (tokens). Persona prompts take ~5-6k. 8192 leaves room on a 16 GB GPU for
# the TTS voice (~3.6 GB); without voice, 16384 fits more history. The backend trims the
# oldest messages if the history would not fit.
OLLAMA_NUM_CTX=8192

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Characters live in characters/<id>/; the app starts with this one
CHARACTERS_DIR=characters
DEFAULT_CHARACTER=akari
# Messages of the active character's conversation sent to the model each turn
SHORT_TERM_MEMORY_SIZE=30

# Voice (optional): local TTS service started with `make tts`
TTS_URL=http://127.0.0.1:8010
# Initial state of the voice toggle; the choice made in the app is remembered
VOICE_ENABLED=true
# Conversations are saved per character in a local SQLite file (gitignored)
MEMORY_PERSIST=true
MEMORY_DB=data/memory.sqlite3
# Long-term memory: facts about you + a summary of what left the recent window
LONG_TERM_MEMORY_ENABLED=true
# Messages folded into long-term memory per update (one background model call each)
MEMORY_BATCH_MESSAGES=20

# Privacy: nothing is captured or sent unless explicitly enabled
PRIVACY_MICROPHONE_ENABLED=false
PRIVACY_CAMERA_ENABLED=false
PRIVACY_REMOTE_VISION_ENABLED=false

# --- Desktop (read by Vite, must start with VITE_) ----------------------
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000/ws
# Avatar renderer: sprite | placeholder (falls back to placeholder if no sprites exist)
VITE_AVATAR_RENDERER=sprite
