{
  "name": "waifu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for the virtual companion",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
